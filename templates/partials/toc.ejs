<input type="checkbox" id="toc-toggle" class="toc-toggle-checkbox">
<label for="toc-toggle" class="toc-backdrop" aria-hidden="true"></label>
<nav class="toc" aria-label="Sommaire du cours">
  <a class="toc-home" href="/index.html">
    <span class="toc-logo" aria-hidden="true">◆</span>
    <span>Apache Superset<small>Data storytelling &amp; dashboarding</small></span>
  </a>
  <div class="progress" aria-live="polite">
    <div class="progress-track"><div class="progress-fill"></div></div>
    <span class="progress-label"></span>
  </div>
  <% lessons.forEach(function (lesson) { %>
    <div class="toc-lesson<%= (page && page.lessonSlug === lesson.slug) ? ' is-current' : '' %>">
      <div class="toc-lesson-title"><span class="toc-lesson-num"><%= lesson.number %></span><%= lesson.title %></div>
      <ul>
        <% lesson.pages.forEach(function (p) { %>
          <li class="<%= (page && page.key === p.key) ? 'is-active' : '' %>">
            <a href="<%= p.url %>" data-page="<%= p.key %>"<%= (page && page.key === p.key) ? ' aria-current="page"' : '' %>><%= p.title %></a>
          </li>
        <% }); %>
      </ul>
    </div>
  <% }); %>
</nav>
