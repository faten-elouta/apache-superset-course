<div class="prev-next">
  <% if (prev) { %>
    <a class="prev-next-link prev" href="<%= prev.url %>">&larr; <%= prev.title %></a>
  <% } else { %>
    <span></span>
  <% } %>
  <% if (next) { %>
    <a class="prev-next-link next" href="<%= next.url %>"><%= next.title %> &rarr;</a>
  <% } %>
</div>
