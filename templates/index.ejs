<!doctype html>
<html lang="fr">
<head>
  <%- include('partials/head') %>
  <title>Apache Superset — Cours</title>
</head>
<body class="home-body">
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <header class="home-topbar">
    <span class="home-brand"><span class="toc-logo" aria-hidden="true">◆</span> Apache Superset</span>
    <button type="button" class="theme-toggle" aria-label="Changer de thème" title="Thème clair / sombre">◐</button>
  </header>

  <main class="home" id="contenu">
    <section class="home-hero">
      <p class="home-kicker">Cours en français · débutant à intermédiaire</p>
      <h1>Raconter des données avec <span>Apache Superset</span></h1>
      <p class="home-intro">
        Un cadre issu de la recherche — un modèle en quatre couches et un
        processus en quatre phases — pour transformer des données en messages
        structurés, puis sa mise en œuvre dans Superset : connexion, dataset,
        graphiques et dashboard. Le fil rouge : les données climatiques du
        projet <strong>PREVIZO</strong>.
      </p>
      <div class="home-actions">
        <a class="btn btn-primary resume-btn" href="<%= firstPage.url %>" data-first="<%= firstPage.url %>">Commencer le cours →</a>
        <a class="btn btn-ghost" href="#parcours">Voir le parcours</a>
        <a class="btn btn-ghost" href="/progression.html">📊 Ma progression</a>
      </div>
      <ul class="home-stats">
        <li><strong><%= lessons.reduce(function (s, l) { return s + l.pages.length; }, 0) %></strong> étapes</li>
        <li><strong>≈ <%= Math.round(totalMinutes / 5) * 5 %></strong> min</li>
        <li><strong>4</strong> phases de méthode</li>
        <li><strong>+20</strong> activités interactives</li>
      </ul>
    </section>

    <section class="home-method" aria-labelledby="methode-titre">
      <h2 id="methode-titre">Le processus qui structure tout le cours</h2>
      <p class="home-section-intro">Les quatre phases du processus d’élaboration d’un récit de données (F. El Outa, <em>A framework for crafting data narratives</em>, thèse, Université de Tours, 2023). Chaque phase travaille une couche du modèle conceptuel ; chaque étape du cours s’y rattache par une pastille colorée. Les phases ne sont pas linéaires : on circule librement de l’une à l’autre.</p>
      <ol class="method-strip">
        <% Object.keys(PHASES).forEach(function (key) { var p = PHASES[key]; %>
          <li class="method-step phase-<%= key %>">
            <span class="method-num"><%= p.n %></span>
            <span class="method-label"><%= p.label %></span>
            <span class="method-layer"><%= p.layer %></span>
            <span class="method-verb"><%= p.verb %></span>
          </li>
        <% }); %>
      </ol>
    </section>

    <section id="parcours" class="home-lessons" aria-labelledby="parcours-titre">
      <h2 id="parcours-titre">Le parcours</h2>
      <div class="lesson-grid">
        <% lessons.forEach(function (lesson) { %>
          <article class="lesson-card" data-lesson="<%= lesson.slug %>">
            <div class="lesson-card-head">
              <span class="lesson-card-num"><%= lesson.number %></span>
              <div>
                <h3><%= lesson.title %></h3>
                <p><%= lesson.subtitle %></p>
              </div>
            </div>
            <div class="lesson-card-progress"><span></span></div>
            <ol>
              <% lesson.pages.forEach(function (p) { %>
                <li>
                  <a href="<%= p.url %>" data-page="<%= p.key %>"><%= p.title %></a>
                  <span class="lesson-card-meta">
                    <% p.phases.forEach(function (ph) { %><i class="phase-dot phase-<%= ph %>" title="Phase <%= PHASES[ph].n %> · <%= PHASES[ph].label %>"></i><% }); %>
                    <%= p.minutes %> min
                  </span>
                </li>
              <% }); %>
            </ol>
          </article>
        <% }); %>
      </div>
    </section>
  </main>
  <footer class="home-footer">Cours Apache Superset — data storytelling &amp; dashboarding · Projet PREVIZO</footer>
  <script src="/assets/js/interactions.js"></script>
</body>
</html>
